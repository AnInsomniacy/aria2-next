ExternalProject_Add(openssl_project
  EXCLUDE_FROM_ALL TRUE
  SOURCE_DIR "${ARIA2_VENDOR_ROOT}/openssl"
  BINARY_DIR "${CMAKE_BINARY_DIR}/vendor/openssl"
  CONFIGURE_COMMAND
    ${CMAKE_COMMAND} -E env ${ARIA2_OPENSSL_ENV}
    ${PERL_EXECUTABLE} <SOURCE_DIR>/Configure
      ${ARIA2_OPENSSL_TARGET}
      ${ARIA2_OPENSSL_CONFIG_ARGS}
      no-shared
      no-module
      no-tests
      no-apps
      no-autoload-config
      --prefix=/
      --openssldir=/etc/ssl
      --libdir=lib
  BUILD_COMMAND
    ${ARIA2_MAKE_EXECUTABLE} -j${ARIA2_BUILD_JOBS}
  INSTALL_COMMAND
    ${ARIA2_MAKE_EXECUTABLE}
      DESTDIR=${ARIA2_DEPENDENCY_PREFIX} install_sw
  UPDATE_COMMAND ""
  TEST_COMMAND "")

