_aria2_next()
{
    local cur prev split=false
    COMPREPLY=()
    COMP_WORDBREAKS=${COMP_WORDBREAKS//=}

    cmd=${COMP_WORDS[0]}
    _get_comp_words_by_ref cur prev
    case $prev in
        --min-tls-version)
            COMPREPLY=( $( compgen -W 'TLSv1.1 TLSv1.2 TLSv1.3' -- "$cur" ) )
            return 0
            ;;
        --filename-hint-source)
            COMPREPLY=( $( compgen -W 'browser title suggested' -- "$cur" ) )
            return 0
            ;;
        --auto-file-renaming-style)
            COMPREPLY=( $( compgen -W 'dot parentheses' -- "$cur" ) )
            return 0
            ;;
        --file-allocation)
            COMPREPLY=( $( compgen -W 'none prealloc falloc trunc' -- "$cur" ) )
            return 0
            ;;
        --follow-torrent)
            COMPREPLY=( $( compgen -W 'true mem false' -- "$cur" ) )
            return 0
            ;;
        --bt-encryption)
            COMPREPLY=( $( compgen -W 'preferred required disabled' -- "$cur" ) )
            return 0
            ;;
        --bt-transport)
            COMPREPLY=( $( compgen -W 'tcp utp both' -- "$cur" ) )
            return 0
            ;;
        --bt-blocklist-scope)
            COMPREPLY=( $( compgen -W 'peers peers-and-trackers all' -- "$cur" ) )
            return 0
            ;;
        --follow-metalink)
            COMPREPLY=( $( compgen -W 'true mem false' -- "$cur" ) )
            return 0
            ;;
        --media)
            COMPREPLY=( $( compgen -W 'auto file hls dash collection' -- "$cur" ) )
            return 0
            ;;
        --media-format)
            COMPREPLY=( $( compgen -W 'mp4 mkv vtt' -- "$cur" ) )
            return 0
            ;;
        --download-result)
            COMPREPLY=( $( compgen -W 'default full hide' -- "$cur" ) )
            return 0
            ;;
        --log-level)
            COMPREPLY=( $( compgen -W 'debug info notice warn error' -- "$cur" ) )
            return 0
            ;;
        --console-log-level)
            COMPREPLY=( $( compgen -W 'debug info notice warn error' -- "$cur" ) )
            return 0
            ;;
        --dir|--state-dir)
            _filedir -d
            return 0
            ;;
        --out|--input-file|--log|--conf-path|--load-cookies|--save-cookies|--ca-certificate|--certificate|--private-key|--netrc-path|--bt-peer-blocklist|--ed2k-server-list|--ed2k-node-list|--save-session|--on-download-start|--on-download-pause|--on-download-stop|--on-download-complete|--on-download-error|--on-bt-download-complete)
            _filedir
            return 0
            ;;
        --torrent-file)
            _filedir '@(torrent)'
            return 0
            ;;
        --metalink-file)
            _filedir '@(meta4|metalink)'
            return 0
            ;;
    esac
    case $cur in
        -*)
            COMPREPLY=( $( compgen -W '--dir --out --input-file --max-concurrent-downloads --continue --check-integrity --log --quiet --daemon --conf-path --no-conf --version --help --split --max-connection-per-server --min-split-size --timeout --connect-timeout --max-tries --retry-wait --lowest-speed-limit --max-download-limit --max-overall-download-limit --user-agent --referer --header --http-user --http-passwd --http-no-cache --http-accept-gzip --enable-http-keep-alive --load-cookies --save-cookies --check-certificate --ca-certificate --certificate --private-key --min-tls-version --all-proxy --all-proxy-user --all-proxy-passwd --http-proxy --http-proxy-user --http-proxy-passwd --https-proxy --https-proxy-user --https-proxy-passwd --no-proxy --dns-over-https --interface --disable-ipv6 --netrc-path --no-netrc --sftp-user --sftp-passwd --ssh-host-key-sha256 --remote-time --checksum --max-file-not-found --filename-hint --filename-hint-source --dry-run --allow-overwrite --auto-file-renaming --incomplete-suffix --auto-file-renaming-style --file-allocation --remove-control-file --force-save --save-not-found --index-out --torrent-file --follow-torrent --select-file --show-files --pause-metadata --listen-port --enable-dht --enable-peer-exchange --bt-enable-lpd --bt-port-mapping --bt-encryption --bt-transport --bt-tracker --bt-exclude-tracker --bt-max-peers --bt-max-connections --bt-max-uploads --bt-max-uploads-per-torrent --max-upload-limit --max-overall-upload-limit --seed-ratio --seed-time --bt-seed-unverified --bt-super-seeding --bt-first-last-piece-first --bt-file-priority --force-sequential --hash-check-only --detach-share-only --bt-external-ip --bt-external-port --bt-interface --bt-proxy --bt-anonymous-mode --bt-user-agent --bt-peer-id-prefix --bt-peer-blocklist --bt-blocklist-scope --bt-rate-limit-overhead --bt-dht-bootstrap-nodes --metalink-file --follow-metalink --ed2k-server --ed2k-server-list --ed2k-node-list --ed2k-listen-port --ed2k-udp-listen-port --ed2k-por