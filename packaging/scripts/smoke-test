#!/bin/sh
# Starts a built engine, drives its BitTorrent session over RPC and checks it
# keeps running and shuts down cleanly. A binary can print --version and still
# crash as soon as libtorrent starts.
set -eu

test $# -eq 1 || {
  echo "Usage: $0 <binary>" >&2
  exit 2
}

binary=$1
command -v curl >/dev/null 2>&1 || {
  echo "Smoke test failed: curl is required" >&2
  exit 1
}

work=$(mktemp -d "${TMPDIR:-/tmp}/aria2-smoke.XXXXXX")
pid=
cleanup() {
  if [ -n "$pid" ]; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -rf "$work"
}
trap cleanup EXIT HUP INT TERM

port=$((20000 + $$ % 20000))
secret=smoke

"$binary" --no-conf --enable-rpc --rpc-listen-port="$port" --rpc-secret="$secret" \
  --dir="$work/downloads" --state-dir="$work/state" > "$work/engine.log" 2>&1 &
pid=$!

fail() {
  echo "Smoke test failed: $1" >&2
  cat "$work/engine.log" >&2
  exit 1
}

alive() {
  kill -0 "$pid" 2>/dev/null
}

# rpc <method> [extra params, each preceded by a comma]
rpc() {
  curl -fsS -m 5 -H 'Content-Type: application/json' \
    -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"$1\",\"params\":[\"token:$secret\"${2:-}]}" \
    "http://127.0.0.1:$port/jsonrpc"
}

tries=0
until rpc aria2.getVersion >/dev/null 2>&1; do
  alive || fail "the engine exited during startup"
  tries=$((tries + 1))
  test "$tries" -lt 50 || fail "RPC did not start"
  sleep 0.2
done

rpc aria2.getBtSessionStatus >/dev/null || fail "aria2.getBtSessionStatus"
rpc aria2.addUri ',["magnet:?xt=urn:btih:0123456789abcdef0123456789abcdef01234567"]' >/dev/null \
  || fail "aria2.addUri with a magnet link"
sleep 3
alive || fail "the engine exited after its BitTorrent session started"

rpc aria2.shutdown >/dev/null || fail "aria2.shutdown"
tries=0
while alive; do
  tries=$((tries + 1))
  test "$tries" -lt 100 || fail "the engine did not shut down"
  sleep 0.2
done
status=0
wait "$pid" || status=$?
pid=
test "$status" -eq 0 || fail "the engine exited with status $status"
echo "Smoke test passed"
