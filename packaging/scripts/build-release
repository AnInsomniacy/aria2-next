#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <linux|macos|windows|android>" >&2
  exit 2
fi

platform=$1
build_dir=${BUILD_DIR:-build/release}
build_type=${CMAKE_BUILD_TYPE:-Release}
build_profile=${ARIA2_BUILD_PROFILE:-release}
strip_binary=${STRIP_BINARY:-true}
release_lto=${ARIA2_RELEASE_LTO:-ON}
prefix="$PWD/$build_dir/dependencies"
export PREFIX="$prefix"
export ARIA2_BUILD_PROFILE="$build_profile"

. packaging/scripts/release-size-profile "$platform"

set -- -S . -B "$build_dir" -G Ninja \
  "-DCMAKE_BUILD_TYPE=$build_type" \
  "-DCMAKE_C_FLAGS=$RELEASE_CFLAGS" \
  "-DCMAKE_CXX_FLAGS=$RELEASE_CXXFLAGS" \
  "-DCMAKE_EXE_LINKER_FLAGS=$RELEASE_LDFLAGS${WINDOWS_DEBUG_MAP_FLAGS:+ $WINDOWS_DEBUG_MAP_FLAGS}" \
  -DARIA2_RELEASE_SIZE_OPTIMIZED=ON \
  "-DARIA2_RELEASE_LTO=$release_lto" \
  -DBUILD_TESTING=OFF \
  -DCMAKE_SKIP_RPATH=ON

case "$platform" in
  linux)
    ;;
  macos)
    : "${TARGET_PROCESSOR:?TARGET_PROCESSOR is required}"
    : "${MACOSX_VERSION_MIN:=11.0}"
    set -- "$@" \
      "-DCMAKE_SYSTEM_PROCESSOR=$TARGET_PROCESSOR" \
      "-DCMAKE_OSX_ARCHITECTURES=$TARGET_PROCESSOR" \
      "-DCMAKE_OSX_DEPLOYMENT_TARGET=$MACOSX_VERSION_MIN" \
      "-DCMAKE_OBJCXX_FLAGS=$RELEASE_CXXFLAGS"
    ;;
  windows)
    : "${TARGET_PROCESSOR:?TARGET_PROCESSOR is required}"
    : "${CC:?CC is required}"
    : "${CXX:?CXX is required}"
    set -- "$@" \
      -DCMAKE_SYSTEM_NAME=Windows \
      "-DCMAKE_SYSTEM_PROCESSOR=$TARGET_PROCESSOR" \
      "-DCMAKE_C_COMPILER=$CC" \
      "-DCMAKE_CXX_COMPILER=$CXX"
    if [ -n "${RC:-}" ]; then
      set -- "$@" "-DCMAKE_RC_COMPILER=$RC"
    fi
    if [ -n "${AR:-}" ]; then
      set -- "$@" "-DCMAKE_AR=$AR"
    fi
    if [ -n "${RANLIB:-}" ]; then
      set -- "$@" "-DCMAKE_RANLIB=$RANLIB"
    fi
    ;;
  android)
    : "${NDK:?NDK is required}"
    : "${API:?API is required}"
    set -- "$@" \
      -DCMAKE_SYSTEM_NAME=Android \
      "-DCMAKE_ANDROID_NDK=$NDK" \
      -DCMAKE_ANDROID_ARCH_ABI=arm64-v8a \
      -DCMAKE_ANDROID_STL_TYPE=c++_static \
      "-DCMAKE_SYSTEM_VERSION=$API"
    ;;
  *)
    echo "Unknown release platform: $platform" >&2
    exit 2
    ;;
esac

cmake "$@"

if command -v nproc >/dev/null 2>&1; then
  jobs=$(nproc)
else
  jobs=$(sysctl -n hw.ncpu)
fi

cmake --build "$build_dir" --target aria2_project -j"$jobs"

binary="$build_dir/aria2-next"
if [ "$platform" = windows ]; then
  binary="$binary.exe"
fi

if [ "$strip_binary" = true ]; then
  "${STRIP:-strip}" "$binary"
fi

case "$platform" in
  windows)
    OBJDUMP="${OBJDUMP:?OBJDUMP is required}" \
      packaging/scripts/check-runtime-deps "${RUNTIME_PLATFORM:?RUNTIME_PLATFORM is required}" "$binary"
    ;;
  android)
    READELF="${READELF:-llvm-readelf}" \
      packaging/scripts/check-runtime-deps android-arm64 "$binary"
    ;;
  *)
    packaging/scripts/check-runtime-deps "$platform" "$binary"
    ;;
esac

case "$platform" in
  linux|macos)
    "$binary" --version
    ;;
esac
